{
  "name": "ktalk-theme-studio",
  "productName": "Kongeuni KT Maker",
  "description": "Android KakaoTalk theme editor by Kongeuni",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "branding": "node build-branding.cjs",
    "package": "npm run branding && electron-packager . KTalkThemeStudio --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/app-icon.ico --ignore=dist --ignore=docs --ignore=verified- --ignore=verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^38.3.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
